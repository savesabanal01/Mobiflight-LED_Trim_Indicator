{
    "$schema": "./mfdevice.schema.json",
    "Info": {
      "Label": "Trim Indicator ESP32-S3",
      "Type": "Trim_Indicator",
      "Author": "Mobiflight",
      "URL": "https://github.com",
      "Version" : "1.0.0"
    },
    "Config": {
      "Pins": [
        "Pin 1",
        "Pin 2",
        "Pin 3"
      ],
